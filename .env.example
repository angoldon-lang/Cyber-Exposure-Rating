# ===========================================================================
# Defenix Security Rating - configurazione di esempio.
# Copiare in `.env` e sostituire TUTTI i valori segnati come obbligatori.
# Il file `.env` non deve mai essere versionato.
#
# Il parser `.env` di Docker Compose NON riconosce i commenti a fine riga:
# tutto cio' che segue `=` diventa parte del valore. I commenti vanno percio'
# sempre su una riga a se'.
#
# Generare i segreti con:
#   openssl rand -base64 48
# ===========================================================================

# --- Applicazione ----------------------------------------------------------
# Valori ammessi: development | staging | production
ENVIRONMENT=development
DEBUG=false
DEFAULT_LANGUAGE=it
API_PORT=8000
FRONTEND_PORT=8080

# --- Database (OBBLIGATORIO) -----------------------------------------------
POSTGRES_USER=defenix
# OBBLIGATORIA: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=defenix
ENABLE_ROW_LEVEL_SECURITY=true

# --- Autenticazione (OBBLIGATORIO) -----------------------------------------
# `local` solo per sviluppo e installazioni minime; in produzione usare `oidc`.
AUTH_MODE=local
# OBBLIGATORIA: openssl rand -base64 48
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OIDC / Keycloak (necessari con AUTH_MODE=oidc) ------------------------
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_ROLES_CLAIM=realm_access.roles
KEYCLOAK_ADMIN=admin
# Obbligatoria se si avvia il profilo `oidc`.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8081

# --- Servizi facoltativi dello stack ---------------------------------------
# Docker Compose legge COMPOSE_PROFILES da questo file, e un servizio
# dichiarato sotto un profilo NON esiste se il profilo non e' elencato qui.
# Senza questa riga `make up` avvia lo stack senza SpiderFoot ne'
# theHarvester: i due adapter non trovano nessuno all'indirizzo configurato,
# la copertura cala, e da nessuna parte compare il motivo vero, che e'
# «il contenitore non e' mai stato avviato».
#
#   osint  SpiderFoot e theHarvester. Gratuiti, nessuna chiave, locali:
#          non c'e' ragione di tenerli spenti, ed e' il valore predefinito.
#   zap    Demone OWASP ZAP. Richiede ZAP_API_KEY: si avvia con `make up-zap`.
#   oidc   Keycloak. Richiede KEYCLOAK_ADMIN_PASSWORD: `make up-oidc`.
#   tor    Proxy Tor, usato dagli strumenti di fase 3.
#
# Piu' profili si separano con la virgola: COMPOSE_PROFILES=osint,zap
COMPOSE_PROFILES=osint

# --- Scansioni -------------------------------------------------------------
# true  = nessun contatto con Internet, dati sintetici deterministici.
# false = esecuzione reale: consentita SOLO con perimetro autorizzato.
SCAN_MOCK_MODE=true
# Deve restare `false`: abilitarlo permetterebbe di scansionare reti interne.
ALLOW_PRIVATE_IP_SCANNING=false
SCAN_MAX_CONCURRENT_TOOLS=4
SCAN_MAX_TARGETS=500
SCAN_DEFAULT_TIMEOUT=600

# --- Sicurezza -------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
RATE_LIMIT_PER_MINUTE=120
SECURE_COOKIES=true
# Chiave Fernet per cifrare le evidenze raw a riposo (opzionale ma consigliata):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVIDENCE_ENCRYPTION_KEY=

# --- Connettori esterni ----------------------------------------------------
# HIBP NON e' open source: richiede una subscription a pagamento.
HIBP_API_KEY=
# Fonte di intelligence su credenziali esposte (stealer log, combolist, paste,
# menzioni su canali chiusi). Anche queste fonti sono tutte commerciali:
# indirizzo e chiave dipendono dal fornitore scelto. Senza, l'adapter si
# dichiara `skipped` e riduce la copertura, senza bloccare la scansione.
CREDENTIAL_EXPOSURE_URL=
CREDENTIAL_EXPOSURE_API_KEY=
# Istanza SpiderFoot. Il valore e' quello del servizio nel compose: vale
# appena il profilo `osint` e' attivo (vedere COMPOSE_PROFILES sopra).
SPIDERFOOT_URL=http://spiderfoot:5001
# Servizio theHarvester, stesso profilo `osint`. Enumera indirizzi e-mail e
# sottodomini da fonti pubbliche: senza di lui la verifica sulle violazioni
# gira senza avere nulla da cercare.
THEHARVESTER_URL=http://theharvester:5000
RANSOMWARE_LIVE_URL=https://api.ransomware.live/v2
KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss

# --- Report ----------------------------------------------------------------
REPORT_BRAND_NAME=Defenix
REPORT_BRAND_OWNER=AD Consulting
REPORT_LOGO_PATH=

# --- OWASP ZAP (profilo `zap`, facoltativo) --------------------------------
# Il demone ZAP gira come servizio a se' nel compose. La chiave la sceglie chi
# installa: serve solo al worker per comandarlo sulla rete interna.
#   openssl rand -hex 24
ZAP_API_KEY=
# Indirizzo del demone. Con il compose e' questo; si imposta anche da
# Personalizzazione -> Strumenti.
ZAP_URL=http://zap:8090
